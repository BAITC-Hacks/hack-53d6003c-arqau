# Optional future AI provider settings. The current app needs no LLM key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Replace this for any shared or deployed environment.
CAREER_QUEST_SECRET=replace-with-a-long-random-secret

# Base dataset directory. Docker Compose mounts this path read-only at /app/dataset.
CAREER_QUEST_DATA_DIR=./dataset

# Optional compatible overlay loaded at startup when running the backend directly.
CAREER_QUEST_EXTRA_DATA_DIR=
