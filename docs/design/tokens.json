{
  "font": {
    "family": "Inter, system-ui, sans-serif",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display": { "size": 56, "weight": 600, "letterSpacing": "-0.04em", "use": "readiness number" },
      "h1": { "size": 26, "weight": 600, "letterSpacing": "-0.02em" },
      "h1Desktop": { "size": 24, "weight": 600, "letterSpacing": "-0.02em" },
      "h2": { "size": 18, "weight": 600, "letterSpacing": "-0.01em" },
      "cardTitle": { "size": 16, "weight": 600 },
      "body": { "size": 15, "lineHeight": 1.5 },
      "small": { "size": 13 },
      "caption": { "size": 12 },
      "overline": { "size": 11, "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase" }
    },
    "numerals": "tabular-nums for timers and KPIs"
  },
  "color": {
    "bg": "#F2F6F8",
    "surface": "#FFFFFF",
    "ink": "#122033",
    "inkSecondary": "#3E4E5E",
    "muted": "#5A6B7D",
    "border": "#E1E8EE",
    "borderSoft": "#EEF3F6",
    "brand": {
      "gradient": "linear-gradient(120deg, #1E4FA8 0%, #0A6F8F 55%, #00815F 100%)",
      "blue": "#1E4FA8",
      "teal": "#0A6F8F",
      "halykGreen": "#00815F"
    },
    "growth": { "fill": "#00815F", "soft": "#E6F3F0", "text": "#00664B", "estimate": "#B7E1D3" },
    "assessed": "#0A6F8F",
    "ai": { "main": "#5B4DB3", "soft": "#EEEBFA", "surface": "#F7F6FC", "border": "#DEDAF3" },
    "youAreHere": { "main": "#F1A400", "soft": "#FDF0CC", "text": "#6E4E00", "surface": "#FFF8E6", "border": "#F3DC9E" },
    "heatmap": ["#EAF2F5", "#B9D9E2", "#5FA3B8", "#0A5C75"],
    "rules": [
      "Gradient ONLY on: Home header, primary CTA, 'Participation verified' success icon. Never on charts or data.",
      "Violet = AI only. Gold = 'you are here' / next step / critical gap marker only.",
      "No red anywhere for low participation. HR support signals use neutral initials + amber/blue/green dots.",
      "Text contrast >= 4.5:1; muted text is #5A6B7D minimum on white."
    ]
  },
  "radius": { "chip": 999, "button": 999, "input": 14, "card": 20, "cardDesktop": 16, "sheet": 28, "heroBottom": 28 },
  "spacing": {
    "mobileGutter": 20,
    "desktopGutter": 32,
    "cardPaddingMobile": 20,
    "cardPaddingDesktop": 18,
    "stackGap": 16,
    "minTouchTarget": 44
  },
  "shadow": { "card": "0 4px 16px rgba(18,32,51,0.05)", "modal": "0 24px 60px rgba(0,0,0,0.25)" },
  "motion": { "ui": "200-300ms ease-out", "growthWebMorph": "600ms ease-in-out", "readinessCountUp": "800ms" },
  "breakpoints": { "mobile": "<768 (390 design width)", "desktop": ">=1024 (1280 design width, sidebar 232)" }
}
